{
  "name": "georgestephanis/load-balanced-sync",
  "description": "Load Balanced Sync WordPress plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.11",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "phpcsstandards/phpcsutils": "^1.0",
    "phpcsstandards/phpcsextra": "^1.3"
  },
  "scripts": {
    "lint": "phpcs --standard=WordPress --extensions=php --ignore=vendor/*,node_modules/*,build/* .",
    "format": "phpcbf --standard=WordPress --extensions=php --ignore=vendor/*,node_modules/*,build/* ."
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
